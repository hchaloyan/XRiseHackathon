# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Backend runtime
backend/chroma/
backend/.env

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Env
.env
.env.*
!.env.example

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded documents are user data, not source. The registry and the files it
# points at are per-machine; the directories are kept so uploads have a home.
data/documents/originals/*
!data/documents/originals/.gitkeep
data/documents/registry.json
