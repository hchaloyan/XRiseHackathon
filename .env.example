# Copy to backend/.env  (the frontend vars go in frontend/.env)

# --- Inference (backend/.env) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text
KEEP_ALIVE=30m

# Hosted fallback. Any OpenAI-compatible endpoint. Unused while LLM_PROVIDER=ollama.
HOSTED_BASE_URL=
HOSTED_API_KEY=
HOSTED_MODEL=

# Timeouts in seconds. On expiry the endpoint returns computed fields only.
INSIGHTS_TIMEOUT=30
ROOT_CAUSE_TIMEOUT=30
SEARCH_TIMEOUT=20

# Retrieval. MAX_MATCH_DISTANCE must be calibrated, not guessed - see spec 7.1.
RETRIEVAL_TOP_K=4
MAX_MATCH_DISTANCE=0.55

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
