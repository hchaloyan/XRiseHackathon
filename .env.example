# Optional. Every setting has a working default in backend/app/config.py, so
# there is NO .env to create for the normal Ollama path — skip this file.
#
# Copy to backend/.env only to switch inference to the hosted fallback, whose
# API key is the one value that must not be committed.
#
# Note: real environment variables outrank anything written here. If your shell
# already exports OLLAMA_HOST (Ollama sets it to a bind address like 0.0.0.0),
# the file value is read and then discarded — config.py handles that case.

LLM_PROVIDER=hosted
HOSTED_BASE_URL=            # any OpenAI-compatible endpoint
HOSTED_API_KEY=
HOSTED_MODEL=
