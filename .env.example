# Optional. Every setting has a working default in backend/app/config.py, so
# the normal Ollama path needs no .env at all.
#
# Copy to backend/.env for either of the two cases below. The API key is the
# one value that must never be committed — backend/.env is gitignored.
#
# Note: real environment variables outrank anything written here. If your shell
# already exports OLLAMA_HOST (Ollama sets it to a bind address like 0.0.0.0),
# the file value is read and then discarded — config.py handles that case.


# --- Case 1: general-knowledge answers in the ask bar (recommended) ---------
#
# Questions the SOPs do not cover get answered from general manufacturing
# knowledge, labelled as such. Everything else — insights, root cause, SOP
# retrieval — stays on the local model, so no figure computed from this
# factory's data ever depends on an external service.
#
# Get a key: https://console.groq.com  →  sign in  →  API Keys  →  Create API Key.
# Copy it immediately; the console shows it once. Free tier, no card required.

HOSTED_API_KEY=gsk_your_key_here

# Defaults already point at Groq, so these two are only worth setting to change
# the model. llama-3.3-70b-versatile was DEPRECATED on Groq in June 2026.
#   openai/gpt-oss-20b    fast, fine for a 3-sentence answer   (default)
#   openai/gpt-oss-120b   slower, better reasoning
#   qwen/qwen3.6-27b      middle ground
# Current list: https://console.groq.com/docs/models
# HOSTED_BASE_URL=https://api.groq.com/openai/v1
# HOSTED_MODEL=openai/gpt-oss-20b

# Who answers off-corpus questions: hosted | ollama | off
# "off" restores the plain redirect and makes the app fully offline again.
# GENERAL_PROVIDER=hosted


# --- Case 2: run the WHOLE app on the hosted model --------------------------
#
# The hour-six escape hatch if the local model is too slow or incoherent.
# Insights and root cause move off Ollama too — one variable, no refactor.
#
# LLM_PROVIDER=hosted
